# -----------------------------------------------------------------------------
# CORE INFRASTRUCTURE (Supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# AUTH & SITE CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://avrxt.dev
NEXT_PUBLIC_API_URL=https://api.avrxt.dev
OPENAUTH_ISSUER_URL=https://auth.avrxt.dev
DISCORD_ADMIN_USER_ID=1269352892146384957
AUTH_CALLBACK_ORIGIN=https://www.avrxt.dev
HEALTH_CHECK_TOKEN=generate-a-long-random-monitoring-token
# Enable only when direct access to the origin is blocked and Cloudflare supplies the header.
TRUST_CLOUDFLARE_PROXY=false
# Set the same server-only value in the API gateway Worker. MAIL_AI_SHARED_SECRET
# is also accepted as the gateway signing secret when this variable is unset.
GATEWAY_SHARED_SECRET=generate-a-long-random-gateway-secret
NODE_ENV=development

# Redis REST cache (server-only; never prefix these with NEXT_PUBLIC_).
# Compatible with Upstash Redis REST; its UPSTASH_REDIS_REST_* names are accepted too.
REDIS_REST_URL=https://your-redis-rest-endpoint
REDIS_REST_TOKEN=your-write-enabled-redis-rest-token
# Use distinct namespaces for production, previews and local development.
REDIS_CACHE_NAMESPACE=avrxt:local

# -----------------------------------------------------------------------------
# SPOTIFY INTEGRATION
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-id
SPOTIFY_CLIENT_SECRET=your-spotify-secret
# Production callback is derived from AUTH_CALLBACK_ORIGIN.
# Local callback: http://localhost:3000/api/spotify/callback

# -----------------------------------------------------------------------------
# STORAGE (Cloudflare R2)
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=avrxt-core
# Comma-separated additional trusted upload origins (for example a Vercel preview).
R2_UPLOAD_ORIGINS=http://localhost:3000
NEXT_PUBLIC_R2_DOMAIN=https://cdn.avrxt.dev
NEXT_PUBLIC_R2_IMAGE_DOMAIN=https://cdn.avrxt.dev
NEXT_PUBLIC_R2_VIDEO_DOMAIN=https://cdn.avrxt.dev

# -----------------------------------------------------------------------------
# MAILING & NEWSLETTER (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_AUDIENCE_ID=your-audience-id
RESEND_DEFAULT_FROM=avrxt Updates <news@avrxt.dev>
RESEND_FROM_DOMAINS=avrxt.dev
NEWSLETTER_UNSUBSCRIBE_BASE_URL=https://unsub.avrxt.dev
MAIL_AI_SHARED_SECRET=generate-a-long-random-secret-and-store-in-vercel-and-cloudflare
MAIL_AI_API_URL=https://api.avrxt.dev/v1/mail/generate

# -----------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# -----------------------------------------------------------------------------
# MONITORING (Betterstack)
# -----------------------------------------------------------------------------
BETTERSTACK_API_KEY=your-betterstack-token
BETTERSTACK_STATUS_PAGE_ID=your-status-page-id

# -----------------------------------------------------------------------------
# COMMUNICATIONS (Discord & YouTube)
# -----------------------------------------------------------------------------
DISCORD_GUILD_ID=your-guild-id
DISCORD_ROLE_ID=your-role-id
DISCORD_TOKEN=your-bot-token
YOUTUBE_API_KEY=your-youtube-api-key

# -----------------------------------------------------------------------------
# CONTACT FORM (Gmail SMTP Fallback)
# -----------------------------------------------------------------------------
GMAIL_APP_PASSWORD=your-app-password
ADMIN_GMAIL_ID=your-email@gmail.com
CONTACT_RECIPIENT_EMAIL=your-email@gmail.com

# Public site search (Algolia)
NEXT_PUBLIC_ALGOLIA_APP_ID=your-app-id
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=avrxt_public
# Search-only, index-scoped key: intentionally public browser configuration.
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-scoped-search-key
# Server-only, same-index addObject/deleteObject/browse/editSettings key.
ALGOLIA_WRITE_KEY=your-scoped-indexing-key
# Protects the daily /api/search/sync job. Generate at least 32 random characters.
CRON_SECRET=generate-a-random-secret
