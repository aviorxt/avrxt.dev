# -----------------------------------------------------------------------------
# CORE INFRASTRUCTURE (Supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Guestbook OAuth providers are configured in Supabase Authentication, not Vercel.
# Add https://<project-ref>.supabase.co/auth/v1/callback to each provider app.

# -----------------------------------------------------------------------------
# AUTH & SITE CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://avrxt.dev
NEXT_PUBLIC_API_URL=https://api.avrxt.dev
# Discord OAuth runs entirely on Vercel. In the Discord Developer Portal, add
# https://www.avrxt.dev/auth/o1/dc/callback as the production redirect URI.
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
# Guestbook GitHub OAuth is AVRXT-owned (not Supabase Auth). Keep these server-only.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Generate with: openssl rand -base64 48. Keep server-only and use a distinct value per environment.
AUTH_SESSION_SECRET=generate-a-64-character-auth-session-secret
DISCORD_ADMIN_USER_ID=1269352892146384957
AUTH_CALLBACK_ORIGIN=https://www.avrxt.dev
HEALTH_CHECK_TOKEN=generate-a-long-random-monitoring-token
# Enable only when direct access to the origin is blocked and Cloudflare supplies the header.
TRUST_CLOUDFLARE_PROXY=false
# Set the same server-only value in the API gateway Worker. MAIL_AI_SHARED_SECRET
# is also accepted as the gateway signing secret when this variable is unset.
GATEWAY_SHARED_SECRET=generate-a-long-random-gateway-secret
NODE_ENV=development

# Redis REST cache (server-only; never prefix these with NEXT_PUBLIC_).
# Compatible with Upstash Redis REST; its UPSTASH_REDIS_REST_* names are accepted too.
REDIS_REST_URL=https://your-redis-rest-endpoint
REDIS_REST_TOKEN=your-write-enabled-redis-rest-token
# Use distinct namespaces for production, previews and local development.
REDIS_CACHE_NAMESPACE=avrxt:local

# -----------------------------------------------------------------------------
# SPOTIFY INTEGRATION
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-id
SPOTIFY_CLIENT_SECRET=your-spotify-secret
# Production callback is derived from AUTH_CALLBACK_ORIGIN.
# Local callback: http://localhost:3000/api/spotify/callback

# -----------------------------------------------------------------------------
# STORAGE (Cloudflare R2)
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=avrxt-core
# Comma-separated additional trusted upload origins (for example a Vercel preview).
R2_UPLOAD_ORIGINS=http://localhost:3000
NEXT_PUBLIC_R2_DOMAIN=https://cdn.avrxt.dev
NEXT_PUBLIC_R2_IMAGE_DOMAIN=https://cdn.avrxt.dev
NEXT_PUBLIC_R2_VIDEO_DOMAIN=https://cdn.avrxt.dev

# Mux Video (server-only). Create a least-privileged Mux API token for video
# uploads/read/delete; never expose either value with NEXT_PUBLIC_.
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# -----------------------------------------------------------------------------
# MAILING & NEWSLETTER (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_AUDIENCE_ID=your-audience-id
RESEND_DEFAULT_FROM=avrxt Updates <news@avrxt.dev>
RESEND_FROM_DOMAINS=avrxt.dev
# Unsubscribe links use https://www.avrxt.dev/preference/mail/unsub/[token].
# No separate unsubscribe-origin variable is required.
MAIL_AI_SHARED_SECRET=generate-a-long-random-secret-and-store-in-vercel-and-cloudflare
MAIL_AI_API_URL=https://api.avrxt.dev/v1/mail/generate

# -----------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# -----------------------------------------------------------------------------
# MONITORING (Betterstack)
# -----------------------------------------------------------------------------
# Public /status reads the public Better Stack JSON feed without account credentials.
# Existing account keys may be retained for external management scripts.
# They are not needed by the public web app.

# -----------------------------------------------------------------------------
# COMMUNICATIONS (Discord & YouTube)
# -----------------------------------------------------------------------------
DISCORD_GUILD_ID=your-guild-id
DISCORD_ROLE_ID=your-role-id
# Optional fallback only. Login authorization uses the user-consented
# guilds.members.read OAuth scope and does not require a Discord bot.
DISCORD_TOKEN=optional-bot-token
YOUTUBE_API_KEY=your-youtube-api-key

# -----------------------------------------------------------------------------
# CONTACT FORM (Gmail SMTP Fallback)
# -----------------------------------------------------------------------------
GMAIL_APP_PASSWORD=your-app-password
ADMIN_GMAIL_ID=your-email@gmail.com
CONTACT_RECIPIENT_EMAIL=your-email@gmail.com

# Public site search (Algolia)
NEXT_PUBLIC_ALGOLIA_APP_ID=your-app-id
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=avrxt_public
# Search-only, index-scoped key: intentionally public browser configuration.
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-scoped-search-key
# Server-only, same-index addObject/deleteObject/browse/editSettings key.
ALGOLIA_WRITE_KEY=your-scoped-indexing-key
# Protects the daily /api/search/sync job. Generate at least 32 random characters.
CRON_SECRET=generate-a-random-secret

# Server-only database monitoring token, also stored in the Better Stack DB monitor.
STATUS_MONITOR_TOKEN=generate-at-least-32-random-characters

# Server-only Discord request channels (never NEXT_PUBLIC_)
DISCORD_DELETE_REQUEST_WEBHOOK_URL=
DISCORD_CONTACT_WEBHOOK_URL=

# Personal dashboard storage (private AWS S3 bucket; keep these server-only)
AWS_S3_BUCKET_NAME=avrxt-private-storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional only for S3-compatible providers; leave blank for AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Private notes (DynamoDB). Create a table whose partition key is `userId`
# (String) and whose sort key is `noteId` (String). The existing AWS server
# credentials above need DynamoDB read/write access to this table only.
NOTES_DYNAMODB_TABLE_NAME=avrxt-private-notes
# Comma-separated Chrome extension IDs permitted to pair with the private notes
# API. Copy this ID from chrome://extensions after loading extensions/avrxt-notes.
NOTES_EXTENSION_IDS=your-32-character-chrome-extension-id

# Short.io branded links (server-only). Create a secret API key at
# https://app.short.io/settings/integrations/api-key. Use the numeric domain ID
# for go.avrxt.dev. The dashboard discovers its domain ID securely at runtime.
SHORT_IO_API_KEY=your-short-io-secret-api-key
SHORT_IO_DOMAIN=go.avrxt.dev
