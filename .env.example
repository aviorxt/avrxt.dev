# Core site and Supabase
NEXT_PUBLIC_SITE_URL=https://www.avrxt.dev
NEXT_PUBLIC_API_URL=https://api.avrxt.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Discord authentication and access control
# Add https://www.avrxt.dev/auth/o1/dc/callback in the Discord Developer Portal.
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
AUTH_SESSION_SECRET=generate-a-64-character-auth-session-secret
AUTH_CALLBACK_ORIGIN=https://www.avrxt.dev
DISCORD_ADMIN_USER_ID=your-discord-user-id
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_ROLE_ID=your-discord-role-id
# Optional fallback for Discord membership lookup. OAuth works without it.
DISCORD_TOKEN=

# Request protection and gateway integration
CRON_SECRET=generate-at-least-32-random-characters
HEALTH_CHECK_TOKEN=generate-at-least-32-random-characters
STATUS_MONITOR_TOKEN=generate-at-least-32-random-characters
# Required only while requests arrive through the Cloudflare proxy.
TRUST_CLOUDFLARE_PROXY=false
# Optional shared signature with the external mail AI gateway.
GATEWAY_SHARED_SECRET=
MAIL_AI_SHARED_SECRET=
MAIL_AI_API_URL=https://api.avrxt.dev/v1/mail/generate

# Redis REST cache (server-only)
REDIS_REST_URL=https://your-redis-rest-endpoint
REDIS_REST_TOKEN=your-redis-rest-token
REDIS_CACHE_NAMESPACE=avrxt:local

# Spotify and YouTube
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
YOUTUBE_API_KEY=your-youtube-api-key

# Cloudflare R2 media storage (server-only credentials)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=avrxt-core
R2_UPLOAD_ORIGINS=http://localhost:3000
NEXT_PUBLIC_R2_DOMAIN=https://cdn.avrxt.dev
NEXT_PUBLIC_R2_IMAGE_DOMAIN=https://cdn.avrxt.dev
NEXT_PUBLIC_R2_VIDEO_DOMAIN=https://cdn.avrxt.dev

# Mux video (server-only)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# Newsletter and public search
RESEND_API_KEY=re_your_api_key
RESEND_AUDIENCE_ID=your-audience-id
RESEND_DEFAULT_FROM=avrxt Updates <news@avrxt.dev>
RESEND_FROM_DOMAINS=avrxt.dev
DISCORD_DELETE_REQUEST_WEBHOOK_URL=
DISCORD_CONTACT_WEBHOOK_URL=
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=avrxt_public
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-search-only-key
ALGOLIA_WRITE_KEY=your-index-write-key

# Personal dashboard storage: a private AWS S3 bucket (server-only)
AWS_S3_BUCKET_NAME=avrxt-private-storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Leave blank for AWS S3; use only for another S3-compatible provider.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Optional build and edge metadata
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_EDGE_BASE_URL=https://edge.avrxt.space
NEXT_PUBLIC_OG_VERSION=
