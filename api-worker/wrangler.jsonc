{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "avrxt-api-gateway",
  "main": "worker.ts",
  "compatibility_date": "2026-08-19",
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "MAIL_AI_LIMITER",
      "namespace_id": "2026100701",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://www.avrxt.dev",
    "MUZIX_SEGMENT_ID": "d4c05cd2-9789-4d1a-8b4c-d3119e4a6166"
  },
  "routes": [
    {
      "pattern": "api.avrxt.dev",
      "custom_domain": true
    }
  ],
  "cache": {
    "enabled": true
  }
}
